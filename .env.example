# Example environment variables for QeRL Docker setup
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Weights & Biases API Key (optional, for experiment tracking)
WANDB_API_KEY=your_wandb_api_key_here

# CUDA Device Selection (default: 0, use "0,1,2,3" for multiple GPUs)
CUDA_VISIBLE_DEVICES=0

# Hugging Face Token (optional, for accessing gated models)
HF_TOKEN=your_huggingface_token_here

# Model paths (optional, can be set in training scripts)
# MODEL_PATH=/workspace/QeRL/models/qwen2.5-7B-nvfp4

# Training configuration (optional, override defaults)
# WANDB_PROJECT=QeRL
# VLLM_ALLOW_RUNTIME_LORA_UPDATING=True
